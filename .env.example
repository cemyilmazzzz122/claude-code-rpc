# Copy this to ~/.claude-code-rpc/.env (created automatically by
# `claude-code-rpc install`) and fill in your own Discord application ID.
# Get one at https://discord.com/developers/applications — see README.md.
DISCORD_CLIENT_ID=

# Optional tuning (defaults shown):
# How often the daemon re-checks state even without a filesystem event, in ms.
# RPC_UPDATE_INTERVAL_MS=15000
# How long a session can go quiet before it's considered dead/stale, in ms.
# RPC_STALE_AFTER_MS=900000
